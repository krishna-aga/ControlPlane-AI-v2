DATABASE_URL=postgresql://user:password@ep-xxxx.neon.tech/controlplane?sslmode=require
JWT_SECRET=change-me-to-a-long-random-string

# Optional. Without this, /check uses a deterministic mock LLM (see
# docs/cross-cutting/llm-integration.md) — the app runs fully without a key.
GEMINI_API_KEY=
# Optional, defaults to a specific model in data_plane/llm_client.py.
GEMINI_MODEL=
